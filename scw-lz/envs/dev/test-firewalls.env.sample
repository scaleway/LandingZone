# Test-firewalls per-env values -- OVERRIDE reference ONLY
# =========================================================
# scw-lz/envs/<ENV>/test-firewalls.env is now GENERATED from live state
# (stage-3 output `firewall_test_config`), so NOTHING here is hand-maintained:
#   - create it:  make fw-test-env            (writes test-firewalls.env)
#   - missing?    test-firewalls.sh auto-runs the generator before sourcing it
#   - rule:       do NOT hand-edit the generated file; regenerate instead.
#
# This .sample documents the variables (sourced by the battery with
# ENV=<ENV>). It is NOT meant to be copied: pre-exported shell vars still win,
# so to override a value just export it before running the battery, e.g.:
#   ENV=dev DOOR=1.2.3.4 ./test-firewalls.sh
# Values only -- no secrets. The script refuses to run when a required value
# is blank.

# Hub VPC public gateway public IP -- the PAT "door" (fw-passive reachable on
# :8022, fw-active on :8023, WebUI on :8443/8444/8445).
DOOR=

# Expected public egress IP of the hub (inspect the egress PGW's flexible IP).
EGRESS=

# Public flexible IPs of the two test spokes.
SPOKE1_IP=
SPOKE2_IP=

# Private LAN IPs of the test spokes (DHCP leases can move on rebuild --
# confirm from inside the instance: ip -4 -o addr show scope global).
SPOKE1_PRIV=
SPOKE2_PRIV=

# Private LAN IP of hub-test (internal-only instance behind the CARP master).
HUBTEST_PRIV=

# Space-separated mgmt CIDRs /32s used for the firewall mgmt reply routes.
MGMT_CIDRS=

# Instance UUIDs of the firewall pair (re-created on rebuild).
FW_PASSIVE_UUID=
FW_ACTIVE_UUID=

# OPTIONAL overrides (defaults in script):
#FW_PASSIVE_ZONE=fr-par-1
#FW_ACTIVE_ZONE=fr-par-2
#LAN_VIP=10.10.0.10
#EGRESS_VIP=10.4.0.10
#EGRESS_PGW=10.4.0.2
#HUB_PGW=10.10.0.2
