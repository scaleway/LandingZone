# ---------------------------------------------------------------------------
# Day-0 ORG-LEVEL credentials template - the OWNER key.
#
# The one file you fill by hand before the first `make bootstrap`: an
# org-level (admin) API key that creates the infra-ops project, the state
# bucket, the per-env projects and their service-account keys. Everything
# else under .creds/ is generated by bootstrap.
#
#   mkdir -p .creds
#   cp templates/creds/lz-creds.env .creds/lz-creds.env
#   $EDITOR .creds/lz-creds.env
#
# The loader sources it as the last fallback before per-env files exist
# (first bootstrap), and `make destroy STAGE=bootstrap` needs an org-level
# key too. Values exported in your shell always win. Keep this template
# EMPTY - real values only in the .creds/ copy.
# ---------------------------------------------------------------------------

# Scaleway API access key of your OWNER (org admin) API key - fill yours
SCW_ACCESS_KEY=

# Matching secret key - fill yours
SCW_SECRET_KEY=

# Your organization id - required. If you prefer the scw-CLI spelling, set
# SCW_DEFAULT_ORGANIZATION_ID instead - the loader derives ORG_ID from it.
ORG_ID=

# SCW_DEFAULT_ORGANIZATION_ID=

# Optional, only set to override the defaults:
# ENV=dev
# REGION=fr-par
# ZONE=fr-par-2
