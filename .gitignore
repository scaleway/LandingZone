# Terraform
.terraform/
**/.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfstate.backup
.state-archive/
tfplan

# tfvars (contains secrets/credentials)
*.tfvars
*.tfvars.json

# Bootstrap-generated per-env config files (contain credentials)
# Generated by scw-lz/bootstrap into scw-lz/envs/<env>/ (also covered by *.tfvars).
scw-lz/envs/*/*.tfvars

# ---------------------------------------------------------------------------
# Live per-env data: real values (IPs/UUIDs) and credential-bearing tfvars
# are kept LOCAL under the <topic>-<env>-demo.* naming and never published.
# The committed <topic>-<env>.yaml / <stage>-<env>.tfvars files beside them
# are sanitized, fill-in templates for the public (negated below).
# ---------------------------------------------------------------------------
scw-lz/envs/*/data/*-demo.yaml
scw-lz/envs/*/*-demo.tfvars

# Canonical tfvars are committed TEMPLATES (placeholder values only) -
# re-include the per-stage ones explicitly.
!scw-lz/envs/dev/0-org-setup-dev.tfvars
!scw-lz/envs/dev/1-security-dev.tfvars
!scw-lz/envs/dev/2-networking-dev.tfvars
!scw-lz/envs/dev/3-security-appliances-dev.tfvars
!scw-lz/envs/dev/4-project-factory-dev.tfvars
!scw-lz/envs/dev/6-interconnection-dev.tfvars
!scw-lz/envs/prod/0-org-setup-prod.tfvars
!scw-lz/envs/prod/1-security-prod.tfvars
!scw-lz/envs/prod/2-networking-prod.tfvars
!scw-lz/envs/prod/3-security-appliances-prod.tfvars
!scw-lz/envs/prod/4-project-factory-prod.tfvars
!scw-lz/envs/prod/6-interconnection-prod.tfvars

# OS
.DS_Store

# draw.io autosave backups (keep on disk, never tracked)
docs/.$*.drawio.bkp

# IDE
.idea/
.vscode/
*.swp
*.swo

# Secrets
*.pem
*.key
!*_rsa.pub

# Temp
tmp/

# Python sources are part of this repo (failover.py, build_fw_template.py, ...)
# Never ignore *.py, the failover function source is deployed from the repo.
# But compiled bytecode caches are build artifacts, always ignored.
__pycache__/
*.pyc

# SSH keys
scw-lz/stages/4-apps/keys/


# HA-firewall module temp/zip
.failover/
modules/ha-firewall/.failover/

# Generated SSH keys
scw-lz/keys/
scw-lz/keys-dev/
scw-lz/keys-prod/
keys-prod/

scw-lz/snapshot/

# Local secrets/keys (operators keep these on disk, never in git)
.creds/
scw-lz/keys/fw-backup-prod/

# Operational test battery, the script IS versioned; only the per-env
# values file (live IPs/UUIDs) stays local. See test-firewalls.env.sample.
scw-lz/envs/*/test-firewalls.env

# Bundled firewall golden images (multi-GB qcow2), never in git/GitHub
# (100 MB / 2 GiB hard limits). Distributed from a public Object Storage URL;
# download and place the file into providers/<vendor>/ before apply. The
# stage-3 upload-wait gate auto-pushes it into the image bucket when present,
# and falls back to the manual "UPLOAD REQUIRED" path when absent.
scw-lz/stages/3-security-appliances/providers/**/*.qcow2
